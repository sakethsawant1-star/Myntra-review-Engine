# Copy to .env for local development. Never commit the populated .env file.
DATABASE_URL=postgresql://user:password@host:5432/database
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-1.5-flash
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:4173
PIPELINE_SCOPE=fresh_sample
PIPELINE_CAP=40
PIPELINE_SOURCES=google_play,reddit_rss
